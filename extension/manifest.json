{
  "manifest_version": 3,
  "name": "SpecSnap – Screen to Field Spec",
  "short_name": "SpecSnap",
  "version": "0.2.0",
  "description": "Turn any system screen into a field spec: forms, lists and detail pages. Compare old vs new screens for migration gaps. Export to Excel or Word.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open SpecSnap",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "side_panel": { "default_path": "sidepanel.html" },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage", "unlimitedStorage", "sidePanel", "activeTab", "scripting"],
  "host_permissions": ["https://api.anthropic.com/*"],
  "optional_host_permissions": ["<all_urls>"],
  "options_page": "options.html"
}
